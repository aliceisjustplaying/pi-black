From f80692609bced7dff96bf7fc7c1c13995af699b9 Mon Sep 17 00:00:00 2001
From: Pi OAuth Compatibility Maintainers <noreply@example.invalid>
Date: Thu, 24 Sep 2026 23:30:04 +0200
Subject: [PATCH] fix(ai): accept renamed Kimi Coding model sources

---
 packages/ai/scripts/generate-models.ts | 11 ++++++++---
 1 file changed, 8 insertions(+), 3 deletions(-)

diff --git a/packages/ai/scripts/generate-models.ts b/packages/ai/scripts/generate-models.ts
index 90e6bbb2..afbd8d00 100644
--- a/packages/ai/scripts/generate-models.ts
+++ b/packages/ai/scripts/generate-models.ts
@@ -2004,9 +2004,14 @@ async function loadModelsDevData(): Promise<Model<any>[]> {
 			}
 		}
 
-		// Process Kimi For Coding models
-		if (data["kimi-for-coding"]?.models) {
-			const kimiModels = data["kimi-for-coding"].models as Record<string, ModelsDevModel>;
+		// Process Kimi For Coding models. models.dev renamed the source provider
+		// to kimi-code-plan-global/kimi-code-plan-cn; accept both names while
+		// keeping the generated Pi provider id stable.
+		const kimiSourceProviderIds = ["kimi-for-coding", "kimi-code-plan-global", "kimi-code-plan-cn"] as const;
+		const kimiModels = Object.fromEntries(
+			kimiSourceProviderIds.flatMap((providerId) => Object.entries(data[providerId]?.models ?? {})),
+		) as Record<string, ModelsDevModel>;
+		if (Object.keys(kimiModels).length > 0) {
 			const hasCanonicalModel = Object.prototype.hasOwnProperty.call(kimiModels, "kimi-for-coding");
 
 			const kimiAliases = new Set(["k2p5", "k2p6", "k2p7"]);
